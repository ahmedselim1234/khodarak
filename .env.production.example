

# Canonical public origin — every absolute URL the app emits (password-reset links,
# robots.txt, sitemap.xml, OpenGraph metadata) is built from it. No trailing slash.
# Must match the Site URL configured in Supabase → Authentication → URL Configuration,
# or reset links will be rewritten to whatever that dashboard says instead.
NEXT_PUBLIC_SITE_URL=https://khodarak-v1ay.vercel.app

# Supabase project settings — the SAME Supabase project every prior phase already used, unless
# the team has separately decided to provision a distinct production project (plan.md's own
# Assumptions: not required by this phase's own scope).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Moyasar — LIVE CUTOVER (User Story 5, FR-013). Replace the pk_test_/sk_test_ values used in
# every prior phase with real live values only in the production environment's own secret
# configuration, in one deliberate step — never partially, never in any other environment.
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

# Shared secret protecting POST /api/cron/renewals (Phase 7) — a real, long random value in
# every environment, including production; not itself part of the live-credential cutover (it's
# not a Moyasar credential).
CRON_SECRET=
