# Supabase project settings (Project Settings → API in the Supabase dashboard)

# Safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — never prefix with NEXT_PUBLIC_, never import outside lib/env.server.ts / lib/supabase/server.ts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Moyasar (Payment Settings → API Keys in the Moyasar dashboard). Use pk_test_/sk_test_ keys in
# every non-production environment — never mix test and live credentials (FR-018).

# Safe to expose to the browser — used only for client-side card tokenization (Moyasar.js)
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_test_your-publishable-key

# Server-only — never prefix with NEXT_PUBLIC_, never import outside lib/payments/ / lib/env.server.ts
MOYASAR_SECRET_KEY=sk_test_your-secret-key
# The secret token configured on the Moyasar dashboard's webhook settings
MOYASAR_WEBHOOK_SECRET=your-webhook-secret-token

# Shared secret protecting POST /api/cron/renewals — set as the Authorization: Bearer header by
# whatever external scheduler triggers the renewal engine. Generate a long random value.
CRON_SECRET=your-cron-secret
